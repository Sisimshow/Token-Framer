{{!-- Token Framer - Injected into Token Config below Image Path --}}
<div class="form-group" data-token-framer="controls">
  <label>
    <i class="fas fa-circle-notch" style="margin-right: 0.25rem; color: var(--color-text-hyperlink);"></i>
    {{localize "TOKEN-FRAMER.Config.Title"}}
  </label>
  <div class="form-fields tfl-controls-row">
    <input type="checkbox" 
           name="flags.{{moduleId}}.frameData.enabled" 
           class="tfl-enable-checkbox"
           {{frameEnabled}}
           title="{{localize 'TOKEN-FRAMER.Config.EnableHint'}}">
    <span class="tfl-enable-label">{{localize "TOKEN-FRAMER.Config.Enable"}}</span>
    <button type="button" class="tfl-configure-button">
      <i class="fas fa-cog"></i>
      {{localize "TOKEN-FRAMER.Config.ConfigureFrame"}}
    </button>
  </div>
  <p class="hint">{{localize "TOKEN-FRAMER.Config.ControlsHint"}}</p>
</div>
