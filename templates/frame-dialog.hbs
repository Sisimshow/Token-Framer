<form class="token-framer-dialog">
  <div class="tfl-dialog-layout">
    
    <!-- Left Column: Preview -->
    <div class="tfl-preview-section">
      <label>{{localize "TOKEN-FRAMER.Config.Preview"}}</label>
      <div class="tfl-preview-wrapper" data-drop-target="base">
        <div class="tfl-preview-placeholder">
          <i class="fas fa-image"></i>
          <span>{{localize "TOKEN-FRAMER.Config.PreviewPlaceholder"}}</span>
        </div>
        <div class="tfl-preview-loading">
          <i class="fas fa-spinner fa-spin"></i>
        </div>
        <div class="tfl-drop-overlay">
          <i class="fas fa-cloud-upload-alt"></i>
          <span>{{localize "TOKEN-FRAMER.Config.DropImage"}}</span>
        </div>
        <img class="tfl-preview-image" src="" alt="{{localize 'TOKEN-FRAMER.Config.Preview'}}">
      </div>
      <button type="button" class="tfl-refresh-button" title="{{localize 'TOKEN-FRAMER.Config.RefreshHint'}}">
        <i class="fas fa-sync-alt"></i>
        {{localize "TOKEN-FRAMER.Config.RefreshFromToken"}}
      </button>
      <button type="button" class="tfl-restore-button tfl-preview-action" title="{{localize 'TOKEN-FRAMER.Config.ResetHint'}}">
        <i class="fas fa-undo"></i>
        {{localize "TOKEN-FRAMER.Config.RestoreOriginal"}}
      </button>
    </div>

    <!-- Right Column: Settings -->
    <div class="tfl-settings-section">

      {{#if autoFrameEnabled}}
      <div class="tfl-auto-frame-badge">
        <i class="fas fa-magic"></i>
        {{localize "TOKEN-FRAMER.Config.AutoFrameActive"}}
      </div>
      {{/if}}
      
      <!-- Base Image -->
      <div class="tfl-form-group">
        <label>{{localize "TOKEN-FRAMER.Config.BaseImage"}}</label>
        <div class="tfl-form-fields">
          <input type="text" name="baseImage" value="{{baseImage}}" placeholder="path/to/base-image.webp">
          <button type="button" class="tfl-icon-button tfl-file-picker" data-target="baseImage" title="{{localize 'TOKEN-FRAMER.Config.BrowseFiles'}}">
            <i class="fas fa-file-import"></i>
          </button>
          <button type="button" class="tfl-icon-button tfl-upload-button" data-target="baseImage" title="{{localize 'TOKEN-FRAMER.Config.UploadFromPC'}}">
            <i class="fas fa-upload"></i>
          </button>
        </div>
        <p class="hint">{{localize "TOKEN-FRAMER.Config.BaseImageInputHint"}}</p>
      </div>

      <!-- Frame Image -->
      <div class="tfl-form-group">
        <label>{{localize "TOKEN-FRAMER.Config.FrameImage"}}</label>
        <div class="tfl-form-fields">
          <input type="text" name="frameImage" value="{{frameImage}}" placeholder="path/to/frame.webp">
          <button type="button" class="tfl-icon-button tfl-file-picker" data-target="frameImage" title="{{localize 'TOKEN-FRAMER.Config.BrowseFiles'}}">
            <i class="fas fa-file-import"></i>
          </button>
          <button type="button" class="tfl-icon-button tfl-upload-button" data-target="frameImage" title="{{localize 'TOKEN-FRAMER.Config.UploadFromPC'}}">
            <i class="fas fa-upload"></i>
          </button>
        </div>
      </div>

      <!-- Base Image Settings -->
      <div class="tfl-collapsible" data-collapsed="false">
        <div class="tfl-collapsible-header">
          <i class="fas fa-chevron-down tfl-collapse-icon"></i>
          <label>{{localize "TOKEN-FRAMER.Config.BaseImageSettings"}}</label>
        </div>
        <div class="tfl-collapsible-content">
          <div class="tfl-form-group">
            <label>{{localize "TOKEN-FRAMER.Config.BaseScale"}}</label>
            <div class="tfl-form-fields">
              <input type="range" name="baseScale" value="{{baseScale}}" min="0.5" max="1.5" step="0.01">
              <input type="number" class="range-value" data-for="baseScale" value="{{baseScale}}" min="0.5" max="1.5" step="0.01">
            </div>
          </div>

          <div class="tfl-form-group tfl-offset-group">
            <label>{{localize "TOKEN-FRAMER.Config.BaseOffset"}}</label>
            <div class="tfl-form-fields">
              <span class="tfl-inline-label">{{localize "TOKEN-FRAMER.Config.LabelX"}}</span>
              <input type="number" name="baseOffsetX" value="{{baseOffsetX}}" step="1" placeholder="0">
              <span class="tfl-inline-label">{{localize "TOKEN-FRAMER.Config.LabelY"}}</span>
              <input type="number" name="baseOffsetY" value="{{baseOffsetY}}" step="1" placeholder="0">
            </div>
          </div>
        </div>
      </div>

      <!-- Frame Settings (moved above Mask Settings) -->
      <div class="tfl-collapsible" data-collapsed="true">
        <div class="tfl-collapsible-header">
          <i class="fas fa-chevron-down tfl-collapse-icon"></i>
          <label>{{localize "TOKEN-FRAMER.Config.FrameSettings"}}</label>
        </div>
        <div class="tfl-collapsible-content">
          <div class="tfl-form-group tfl-toggle-row">
            <div class="tfl-toggle-option">
              <input type="checkbox" name="baseOverFrame" id="tfl-base-over-frame" {{baseOverFrame}}>
              <label for="tfl-base-over-frame">{{localize "TOKEN-FRAMER.Config.BaseOverFrame"}}</label>
            </div>
            <p class="hint">{{localize "TOKEN-FRAMER.Config.BaseOverFrameHint"}}</p>
          </div>

          <div class="tfl-form-group">
            <label>{{localize "TOKEN-FRAMER.Config.FrameScale"}}</label>
            <div class="tfl-form-fields">
              <input type="range" name="frameScale" value="{{frameScale}}" min="0.5" max="1.5" step="0.01">
              <input type="number" class="range-value" data-for="frameScale" value="{{frameScale}}" min="0.5" max="1.5" step="0.01">
            </div>
          </div>

          <div class="tfl-form-group tfl-offset-group">
            <label>{{localize "TOKEN-FRAMER.Config.FrameOffset"}}</label>
            <div class="tfl-form-fields">
              <span class="tfl-inline-label">{{localize "TOKEN-FRAMER.Config.LabelX"}}</span>
              <input type="number" name="frameOffsetX" value="{{frameOffsetX}}" step="1" placeholder="0">
              <span class="tfl-inline-label">{{localize "TOKEN-FRAMER.Config.LabelY"}}</span>
              <input type="number" name="frameOffsetY" value="{{frameOffsetY}}" step="1" placeholder="0">
            </div>
          </div>
        </div>
      </div>

      <!-- Mask Settings -->
      <div class="tfl-collapsible" data-collapsed="true">
        <div class="tfl-collapsible-header">
          <i class="fas fa-chevron-down tfl-collapse-icon"></i>
          <label>{{localize "TOKEN-FRAMER.Config.MaskSettings"}}</label>
        </div>
        <div class="tfl-collapsible-content">
          <div class="tfl-form-group">
            <label>{{localize "TOKEN-FRAMER.Config.MaskShape"}}</label>
            <div class="tfl-form-fields">
              <select name="maskShape">
                <option value="circle" {{#if (eq maskShape "circle")}}selected{{/if}}>{{localize "TOKEN-FRAMER.Config.MaskShapeCircle"}}</option>
                <option value="square" {{#if (eq maskShape "square")}}selected{{/if}}>{{localize "TOKEN-FRAMER.Config.MaskShapeSquare"}}</option>
                <option value="hexagon" {{#if (eq maskShape "hexagon")}}selected{{/if}}>{{localize "TOKEN-FRAMER.Config.MaskShapeHexagon"}}</option>
                <option value="none" {{#if (eq maskShape "none")}}selected{{/if}}>{{localize "TOKEN-FRAMER.Config.MaskShapeNone"}}</option>
              </select>
            </div>
            <p class="hint">{{localize "TOKEN-FRAMER.Config.MaskShapeHint"}}</p>
          </div>

          <!-- Mask Image (moved here) -->
          <div class="tfl-form-group">
            <label>{{localize "TOKEN-FRAMER.Config.MaskImage"}}</label>
            <div class="tfl-form-fields">
              <input type="text" name="maskImage" value="{{maskImage}}" placeholder="{{localize 'TOKEN-FRAMER.Config.MaskImagePlaceholder'}}">
              <button type="button" class="tfl-icon-button tfl-file-picker" data-target="maskImage" title="{{localize 'TOKEN-FRAMER.Config.BrowseFiles'}}">
                <i class="fas fa-file-import"></i>
              </button>
              <button type="button" class="tfl-icon-button tfl-upload-button" data-target="maskImage" title="{{localize 'TOKEN-FRAMER.Config.UploadFromPC'}}">
                <i class="fas fa-upload"></i>
              </button>
            </div>
            <p class="hint">{{localize "TOKEN-FRAMER.Config.MaskImageHint"}}</p>
          </div>

          <div class="tfl-form-group">
            <label>{{localize "TOKEN-FRAMER.Config.MaskScale"}}</label>
            <div class="tfl-form-fields">
              <input type="range" name="maskSize" value="{{maskSize}}" min="0.5" max="1.5" step="0.01">
              <input type="number" class="range-value" data-for="maskSize" value="{{maskSize}}" min="0.5" max="1.5" step="0.01">
            </div>
            <p class="hint">{{localize "TOKEN-FRAMER.Config.MaskScaleHint"}}</p>
          </div>

          <div class="tfl-form-group tfl-offset-group">
            <label>{{localize "TOKEN-FRAMER.Config.MaskOffset"}}</label>
            <div class="tfl-form-fields">
              <span class="tfl-inline-label">{{localize "TOKEN-FRAMER.Config.LabelX"}}</span>
              <input type="number" name="maskOffsetX" value="{{maskOffsetX}}" step="1" placeholder="0">
              <span class="tfl-inline-label">{{localize "TOKEN-FRAMER.Config.LabelY"}}</span>
              <input type="number" name="maskOffsetY" value="{{maskOffsetY}}" step="1" placeholder="0">
            </div>
          </div>
        </div>
      </div>

      <!-- Overlay/Decoration Settings (moved above Background) -->
      <div class="tfl-collapsible" data-collapsed="true">
        <div class="tfl-collapsible-header">
          <i class="fas fa-chevron-down tfl-collapse-icon"></i>
          <label>{{localize "TOKEN-FRAMER.Config.Overlay"}}</label>
        </div>
        <div class="tfl-collapsible-content">
          <div class="tfl-form-group">
            <label>{{localize "TOKEN-FRAMER.Config.OverlayImage"}}</label>
            <div class="tfl-form-fields">
              <input type="text" name="overlayImage" value="{{overlayImage}}" placeholder="{{localize 'TOKEN-FRAMER.Config.OverlayImagePlaceholder'}}">
              <button type="button" class="tfl-icon-button tfl-file-picker" data-target="overlayImage" title="{{localize 'TOKEN-FRAMER.Config.BrowseFiles'}}">
                <i class="fas fa-file-import"></i>
              </button>
              <button type="button" class="tfl-icon-button tfl-upload-button" data-target="overlayImage" title="{{localize 'TOKEN-FRAMER.Config.UploadFromPC'}}">
                <i class="fas fa-upload"></i>
              </button>
            </div>
            <p class="hint">{{localize "TOKEN-FRAMER.Config.OverlayHint"}}</p>
          </div>

          <div class="tfl-form-group">
            <label>{{localize "TOKEN-FRAMER.Config.OverlayScale"}}</label>
            <div class="tfl-form-fields">
              <input type="range" name="overlayScale" value="{{overlayScale}}" min="0.5" max="1.5" step="0.01">
              <input type="number" class="range-value" data-for="overlayScale" value="{{overlayScale}}" min="0.5" max="1.5" step="0.01">
            </div>
          </div>

          <div class="tfl-form-group tfl-offset-group">
            <label>{{localize "TOKEN-FRAMER.Config.OverlayOffset"}}</label>
            <div class="tfl-form-fields">
              <span class="tfl-inline-label">{{localize "TOKEN-FRAMER.Config.LabelX"}}</span>
              <input type="number" name="overlayOffsetX" value="{{overlayOffsetX}}" step="1" placeholder="0">
              <span class="tfl-inline-label">{{localize "TOKEN-FRAMER.Config.LabelY"}}</span>
              <input type="number" name="overlayOffsetY" value="{{overlayOffsetY}}" step="1" placeholder="0">
            </div>
          </div>
        </div>
      </div>

      <!-- Pop Out Settings -->
      <div class="tfl-collapsible" data-collapsed="true">
        <div class="tfl-collapsible-header">
          <i class="fas fa-chevron-down tfl-collapse-icon"></i>
          <label>{{localize "TOKEN-FRAMER.Config.PopOut"}}</label>
        </div>
        <div class="tfl-collapsible-content">
          <div class="tfl-form-group tfl-toggle-row">
            <div class="tfl-toggle-option">
              <input type="checkbox" name="popOutEnabled" id="tfl-pop-out-enabled" {{popOutEnabled}}>
              <label for="tfl-pop-out-enabled">{{localize "TOKEN-FRAMER.Config.PopOutEnable"}}</label>
            </div>
            <p class="hint">{{localize "TOKEN-FRAMER.Config.PopOutHint"}}</p>
          </div>

          <div class="tfl-form-group tfl-toggle-row">
            <div class="tfl-toggle-option">
              <input type="checkbox" name="popOutPreview" id="tfl-pop-out-preview">
              <label for="tfl-pop-out-preview">{{localize "TOKEN-FRAMER.Config.PopOutPreview"}}</label>
            </div>
            <p class="hint">{{localize "TOKEN-FRAMER.Config.PopOutPreviewHint"}}</p>
          </div>

          <div class="tfl-form-group">
            <label>{{localize "TOKEN-FRAMER.Config.PopOutDegrees"}}</label>
            <div class="tfl-form-fields">
              <input type="range" name="popOutDegrees" value="{{popOutDegrees}}" min="1" max="360" step="1">
              <input type="number" class="range-value" data-for="popOutDegrees" value="{{popOutDegrees}}" min="1" max="360" step="1">
            </div>
            <p class="hint">{{localize "TOKEN-FRAMER.Config.PopOutDegreesHint"}}</p>
          </div>

          <div class="tfl-form-group">
            <label>{{localize "TOKEN-FRAMER.Config.PopOutRotation"}}</label>
            <div class="tfl-form-fields">
              <input type="range" name="popOutRotation" value="{{popOutRotation}}" min="-180" max="180" step="1">
              <input type="number" class="range-value" data-for="popOutRotation" value="{{popOutRotation}}" min="-180" max="180" step="1">
            </div>
            <p class="hint">{{localize "TOKEN-FRAMER.Config.PopOutRotationHint"}}</p>
          </div>

          <div class="tfl-form-group tfl-offset-group">
            <label>{{localize "TOKEN-FRAMER.Config.PopOutOffset"}}</label>
            <div class="tfl-form-fields">
              <span class="tfl-inline-label">{{localize "TOKEN-FRAMER.Config.LabelX"}}</span>
              <input type="number" name="popOutOffsetX" value="{{popOutOffsetX}}" step="1" placeholder="0">
              <span class="tfl-inline-label">{{localize "TOKEN-FRAMER.Config.LabelY"}}</span>
              <input type="number" name="popOutOffsetY" value="{{popOutOffsetY}}" step="1" placeholder="0">
            </div>
          </div>
        </div>
      </div>

      <!-- Background Settings -->
      <div class="tfl-collapsible" data-collapsed="true">
        <div class="tfl-collapsible-header">
          <i class="fas fa-chevron-down tfl-collapse-icon"></i>
          <label>{{localize "TOKEN-FRAMER.Config.Background"}}</label>
        </div>
        <div class="tfl-collapsible-content">
          <div class="tfl-form-group tfl-bg-row">
            <div class="tfl-bg-enable">
              <input type="checkbox" name="bgEnabled" id="tfl-bg-enabled" {{bgEnabled}}>
              <label for="tfl-bg-enabled">{{localize "TOKEN-FRAMER.Config.BackgroundEnable"}}</label>
            </div>
            <div class="tfl-bg-color">
              <label>{{localize "TOKEN-FRAMER.Config.BackgroundColor"}}</label>
              <input type="color" name="bgColor" value="{{bgColor}}" class="tfl-color-picker">
              <input type="text" name="bgColorText" value="{{bgColor}}" class="tfl-color-text" placeholder="#000000">
            </div>
          </div>

          <div class="tfl-form-group">
            <label>{{localize "TOKEN-FRAMER.Config.BackgroundImage"}}</label>
            <div class="tfl-form-fields">
              <input type="text" name="bgImage" value="{{bgImage}}" placeholder="{{localize 'TOKEN-FRAMER.Config.BackgroundImagePlaceholder'}}">
              <button type="button" class="tfl-icon-button tfl-file-picker" data-target="bgImage" title="{{localize 'TOKEN-FRAMER.Config.BrowseFiles'}}">
                <i class="fas fa-file-import"></i>
              </button>
              <button type="button" class="tfl-icon-button tfl-upload-button" data-target="bgImage" title="{{localize 'TOKEN-FRAMER.Config.UploadFromPC'}}">
                <i class="fas fa-upload"></i>
              </button>
            </div>
          </div>

          <div class="tfl-form-group">
            <label>{{localize "TOKEN-FRAMER.Config.BackgroundImageScale"}}</label>
            <div class="tfl-form-fields">
              <input type="range" name="bgImageScale" value="{{bgImageScale}}" min="0.5" max="1.5" step="0.01">
              <input type="number" class="range-value" data-for="bgImageScale" value="{{bgImageScale}}" min="0.5" max="1.5" step="0.01">
            </div>
          </div>

          <div class="tfl-form-group tfl-offset-group">
            <label>{{localize "TOKEN-FRAMER.Config.BackgroundImageOffset"}}</label>
            <div class="tfl-form-fields">
              <span class="tfl-inline-label">{{localize "TOKEN-FRAMER.Config.LabelX"}}</span>
              <input type="number" name="bgImageOffsetX" value="{{bgImageOffsetX}}" step="1" placeholder="0">
              <span class="tfl-inline-label">{{localize "TOKEN-FRAMER.Config.LabelY"}}</span>
              <input type="number" name="bgImageOffsetY" value="{{bgImageOffsetY}}" step="1" placeholder="0">
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>

  <!-- Footer Actions -->
  <footer class="tfl-dialog-footer">
    <button type="button" class="tfl-save-image-button" title="{{localize 'TOKEN-FRAMER.Config.SaveAsHint'}}">
      <i class="fas fa-file-export"></i>
      {{localize "TOKEN-FRAMER.Config.SaveAs"}}
    </button>
    <button type="button" class="tfl-quick-save-button" title="{{#if autoFrameEnabled}}{{localize 'TOKEN-FRAMER.Config.QuickSaveDisabledHint'}}{{else}}{{localize 'TOKEN-FRAMER.Config.QuickSaveHint'}}{{/if}}" {{#if autoFrameEnabled}}disabled{{/if}}>
      <i class="fas fa-bolt"></i>
      {{localize "TOKEN-FRAMER.Config.QuickSave"}}
    </button>
    <button type="button" class="tfl-apply-button" title="{{localize 'TOKEN-FRAMER.Config.ApplyAutoFrameHint'}}">
      <i class="fas fa-magic"></i>
      {{localize "TOKEN-FRAMER.Config.ApplyAutoFrame"}}
    </button>
  </footer>
</form>
